<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
    <!ENTITY name      "vault">
    <!ENTITY author    "Ruaan Deysel">
    <!ENTITY version   "2026.11.01">
    <!ENTITY launch    "Settings/Vault">
    <!ENTITY gitURL    "https://github.com/tinkerologie/&name;">
    <!ENTITY pluginURL "https://raw.githubusercontent.com/tinkerologie/&name;/main/plugin/vault.plg">
    <!ENTITY bundle    "&name;-&version;.txz">
    <!ENTITY bundleURL "&gitURL;/releases/download/v&version;/&bundle;">
    <!ENTITY sha256      "49d6c10d944767ff58927667b48061ad794c737681d74a71109af3b956917839">
    <!ENTITY support   "https://forums.unraid.net/topic/197786-plugin-vault-backup-manager">
]>
<PLUGIN name="&name;" author="&author;" version="&version;"
        launch="&launch;" pluginURL="&pluginURL;" icon="shield"
        min="7.0" support="&support;"
        project="&gitURL;"
        readme="&gitURL;#readme">

<CHANGES><![CDATA[
## v2026.11.01

### Added

- Canonical domain glossary and retrospective architecture decisions, with source-linked implementation guidance.

### Fixed

- Publish the plugin version, checksum, and release notes together after the release package is available, so updates keep working during publication.
- Keep screen-reader focus on page headings after navigation and reserve the visible focus ring for keyboard controls.
- Wait for active HTTP requests, WebSockets, mounts, and daemon workers before closing Vault resources during shutdown (#624).
- Save a Job and its items together so a failed item write leaves the prior Job and selection intact (#623).
- Acknowledge reviewed run warnings from History without removing backup or restore records. The Dashboard clears the reviewed warnings and updates its health score (#627).
- Remove deleted or excluded files from classic incremental folder and plugin restores even when the restored files retain old timestamps. Only prune files that the replay wrote.

### Changed

- Job create and update responses return the stored records, including timestamps and source ID. Creating a Job also saves the requested anomaly sensitivity.
- Revise the user guides and reference prose for ASD-STE100 Issue 9.
]]></CHANGES>

<!-- Prepare persistent plugin storage and prune stale cached bundles -->
<FILE Run="/bin/bash">
    <INLINE><![CDATA[
PLUGIN_DIR="/boot/config/plugins/vault"
CURRENT_BUNDLE="&bundle;"

mkdir -p "$PLUGIN_DIR"

find "$PLUGIN_DIR" -maxdepth 1 -type f \( -name 'vault-*.txz' -o -name 'vault-*.tgz' \) \
    ! -name "$CURRENT_BUNDLE" -delete 2>/dev/null || true
]]></INLINE>
</FILE>

<!-- Require Unraid 7.0 or later -->
<FILE Run="/bin/bash">
    <INLINE><![CDATA[
source /etc/unraid-version
if [[ "${version%%.*}" -lt 7 ]]; then
    echo "Vault requires Unraid 7.0 or later"
    exit 1
fi
]]></INLINE>
</FILE>

<!--
    Stop any running Vault daemon before upgrading the package.

    Without this, upgradepkg replaces the on-disk binary while the previous
    daemon is still running, the post-install "start" sees an existing PID
    and exits silently, and the user keeps running the OLD binary until they
    reboot the server (issue #72).

    Persistent state under /boot/config/plugins/vault (vault.cfg, vault.db,
    sealed credentials) is intentionally left untouched so user settings and
    configuration survive the upgrade.
-->
<FILE Run="/bin/bash">
    <INLINE><![CDATA[
if [ -x /etc/rc.d/rc.vault ]; then
    echo "Stopping Vault daemon before upgrade..."
    /etc/rc.d/rc.vault stop || echo "Warning: rc.vault stop reported a non-zero status; continuing"
fi

# Belt-and-braces: ensure no stray vault process is still holding the binary.
attempts=15
while pidof vault >/dev/null 2>&1 && [ "$attempts" -gt 0 ]; do
    sleep 1
    attempts=$((attempts - 1))
done

if pidof vault >/dev/null 2>&1; then
    echo "Vault daemon did not exit gracefully; forcing shutdown..."
    killall -9 vault 2>/dev/null || true
    sleep 1
fi

# Stale pidfile would block the post-install start step.
rm -f /var/run/vault.pid
]]></INLINE>
</FILE>

<!-- Download and install the bundle -->
<FILE Name="/boot/config/plugins/&name;/&bundle;" Run="upgradepkg --install-new">
    <URL>&bundleURL;</URL>
    <SHA256>&sha256;</SHA256>
</FILE>

<!-- Post-install: create default config and start daemon -->
<FILE Run="/bin/bash">
    <INLINE><![CDATA[
# Create default config if missing
CONFIG="/boot/config/plugins/vault/vault.cfg"
if [ ! -f "$CONFIG" ]; then
    cat > "$CONFIG" <<'CFGEOF'
PORT=24085
BIND_ADDRESS=127.0.0.1
MDNS_ADVERTISE=yes
# SNAPSHOT_PATH – Custom snapshot location (set by the daemon; do not edit manually)
CFGEOF
fi

# Create data directory
mkdir -p /boot/config/plugins/vault

# Ensure permissions
chmod 755 /usr/local/sbin/vault
chmod 755 /etc/rc.d/rc.vault
# apply.sh is executed directly by /update.php via popen() after a settings
# save; without the exec bit the call fails with a silent "Permission denied"
# and the daemon never restarts onto the new bind address/port.
chmod 755 /usr/local/emhttp/plugins/vault/include/apply.sh
# emhttp event scripts (array started / stopping_svcs) must be executable or
# Unraid silently skips them — the graceful reboot flush depends on them (#241).
chmod 755 /usr/local/emhttp/plugins/vault/event/started \
          /usr/local/emhttp/plugins/vault/event/stopping_svcs 2>/dev/null || true

# Remove files left by the legacy PHP UI (#533). This is explicit so the result
# doesn't depend on upgradepkg, and it also covers files a manual or dev deploy
# placed outside the package. Never touch ui/: the package just installed it.
# BEGIN legacy-ui-cleanup
LEGACY_UI_DIR="/usr/local/emhttp/plugins/vault"
if [ -n "$LEGACY_UI_DIR" ] && [ -d "$LEGACY_UI_DIR" ]; then
    rm -f "$LEGACY_UI_DIR/VaultJobs.page" \
          "$LEGACY_UI_DIR/VaultRestore.page" \
          "$LEGACY_UI_DIR/VaultStorage.page" \
          "$LEGACY_UI_DIR/VaultHistory.page" \
          "$LEGACY_UI_DIR/VaultSettings.page"
    rm -rf "$LEGACY_UI_DIR/assets"
fi
# END legacy-ui-cleanup

# Restart cleanly: stop any leftover daemon (e.g. from an aborted previous
# upgrade) before starting the new binary. This guarantees the user is
# running the just-installed version without requiring a server reboot.
/etc/rc.d/rc.vault stop 2>/dev/null || true
/etc/rc.d/rc.vault start

echo "Vault plugin installed successfully"
]]></INLINE>
</FILE>

<!-- Removal script -->
<FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
DAEMON="/usr/local/sbin/vault"
CONFIG_DIR="/boot/config/plugins/vault"
DB="${CONFIG_DIR}/vault.db"

# Stop daemon
/etc/rc.d/rc.vault stop 2>/dev/null || true

# Wait for the daemon to finish any final snapshot flush before cleanup.
attempts=20
while pidof vault >/dev/null 2>&1 && [ "$attempts" -gt 0 ]; do
    sleep 1
    attempts=$((attempts - 1))
done

if pidof vault >/dev/null 2>&1; then
    killall -9 vault 2>/dev/null || true
    sleep 1
fi

# Remove installed package files
PACKAGE=""
for pkg in /var/log/packages/vault-*; do
    [ -e "$pkg" ] || continue
    PACKAGE="$(basename "$pkg")"
done

if [ -z "$PACKAGE" ]; then
    for pkg in /boot/config/plugins/vault/vault-*.txz /boot/config/plugins/vault/vault-*.tgz; do
        [ -e "$pkg" ] || continue
        case "$pkg" in
            *.txz) PACKAGE="$(basename "$pkg" .txz)" ;;
            *.tgz) PACKAGE="$(basename "$pkg" .tgz)" ;;
        esac
    done
fi

if [ -x "$DAEMON" ]; then
    "$DAEMON" cleanup-uninstall \
        --db="$DB" \
        --config-dir="$CONFIG_DIR" \
        --binary-path="$DAEMON" \
        --rc-script="/etc/rc.d/rc.vault" \
        --plugin-dir="/usr/local/emhttp/plugins/vault" \
        --log-path="/var/log/vault.log" \
        --pid-file="/var/run/vault.pid" \
        --hybrid-working-dir="/var/local/vault" \
        || echo "Vault uninstall cleanup reported a warning; continuing with package removal"
fi

if [ -n "$PACKAGE" ]; then
    removepkg "$PACKAGE" 2>/dev/null || true
fi

# Fallback cleanup if the binary was already missing.
rm -f "$DAEMON"
rm -f /etc/rc.d/rc.vault
rm -rf /usr/local/emhttp/plugins/vault
rm -f /var/log/vault.log
rm -f /var/run/vault.pid
rm -rf /boot/config/plugins/vault/*.txz
rm -rf /boot/config/plugins/vault/*.tgz
# Empty-only: never remove a FUSE mount root that still holds anything.
rmdir /mnt/vault-fuse /mnt/addons/vault-fuse 2>/dev/null || true

echo "Vault plugin removed"
]]></INLINE>
</FILE>

</PLUGIN>
