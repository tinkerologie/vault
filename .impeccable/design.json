  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action to take in a screen region.",
      "html": "<button class=\"ds-btn-primary\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" d=\"M12 5v14M5 12h14\"/></svg>New Job</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;font-size:14px;font-weight:500;border:0;border-radius:8px;cursor:pointer;transition:background-color .15s,color .15s;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;background:var(--color-vault,#f59e0b);color:var(--color-on-vault,#111827);}.ds-btn-primary:hover{background:var(--color-vault-dark,#d97706);}.ds-btn-primary:focus-visible{outline:2px solid var(--color-vault,#f59e0b);outline-offset:2px;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting actions beside a primary.",
      "html": "<button class=\"ds-btn-secondary\">Cancel</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;font-size:14px;font-weight:500;border:0;border-radius:8px;cursor:pointer;transition:background-color .15s,color .15s;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;background:var(--color-surface-3,#f3f4f6);color:var(--color-text-muted,#4b5563);}.ds-btn-secondary:hover{background:var(--color-surface-4,#e5e7eb);color:var(--color-text,#111827);}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-vault,#f59e0b);outline-offset:2px;}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Confirm button of a destructive dialog only.",
      "html": "<button class=\"ds-btn-danger\">Delete Job</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;font-size:14px;font-weight:500;border:0;border-radius:8px;cursor:pointer;transition:background-color .15s,color .15s;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;background:var(--color-danger,#991b1b);color:var(--color-on-status,#fff);}.ds-btn-danger:hover{opacity:.9;}.ds-btn-danger:focus-visible{outline:2px solid var(--color-vault,#f59e0b);outline-offset:2px;}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Sunken field with a visible label above.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Destination name</span><input class=\"ds-input\" placeholder=\"My Backup Target\"><span class=\"ds-field-help\">Shown in jobs and history.</span></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;max-width:320px}.ds-field-label{font-size:14px;font-weight:500;color:var(--color-text,#111827)}.ds-field-help{font-size:12px;color:var(--color-text-dim,#5f6673)}.ds-input{padding:8px 12px;font-size:14px;background:var(--color-surface-3,#f3f4f6);border:1px solid var(--color-border,#e5e7eb);border-radius:8px;color:var(--color-text,#111827)}.ds-input::placeholder{color:var(--color-text-muted,#4b5563)}.ds-input:focus-visible{outline:2px solid var(--color-vault,#f59e0b);outline-offset:2px}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-success",
      "description": "Status as tinted pill text, always with a word.",
      "html": "<span class=\"ds-badge ds-ok\">Completed</span> <span class=\"ds-badge ds-bad\">Failed</span> <span class=\"ds-badge ds-warn\">Partial</span> <span class=\"ds-badge ds-neutral\">Skipped</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;padding:2px 10px;border-radius:9999px;font-size:12px;font-weight:500;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}.ds-ok{color:var(--color-success,#166534);background:color-mix(in srgb,var(--color-success,#166534) 15%,transparent)}.ds-bad{color:var(--color-danger,#991b1b);background:color-mix(in srgb,var(--color-danger,#991b1b) 15%,transparent)}.ds-warn{color:var(--color-warning,#92400e);background:color-mix(in srgb,var(--color-warning,#92400e) 15%,transparent)}.ds-neutral{color:var(--color-text-muted,#4b5563);background:var(--color-surface-3,#f3f4f6)}"
    },
    {
      "name": "Summary Tile",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat bordered dashboard tile; border warms on hover.",
      "html": "<a class=\"ds-tile\" href=\"#\"><span class=\"ds-tile-eyebrow\">Protected</span><span class=\"ds-tile-value\">20<small>/25</small></span><span class=\"ds-tile-meta\">5 unprotected →</span></a>",
      "css": ".ds-tile{display:flex;flex-direction:column;gap:4px;width:220px;padding:14px;background:var(--color-surface-2,#f9fafb);border:1px solid var(--color-border,#e5e7eb);border-radius:12px;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;transition:border-color .15s}.ds-tile:hover{border-color:color-mix(in srgb,var(--color-vault,#f59e0b) 40%,transparent)}.ds-tile:focus-visible{outline:2px solid var(--color-vault,#f59e0b);outline-offset:2px}.ds-tile-eyebrow{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--color-text-muted,#4b5563)}.ds-tile-value{font-size:24px;font-weight:700;color:var(--color-text,#111827);font-variant-numeric:tabular-nums}.ds-tile-value small{font-size:14px;font-weight:400;color:var(--color-text-dim,#5f6673)}.ds-tile-meta{font-size:12px;color:var(--color-vault-text,#92400e)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Grouped sidebar; active item tinted amber with aria-current.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Sidebar\"><span class=\"ds-nav-group\">Protect</span><a class=\"ds-nav-item\" aria-current=\"page\" href=\"#\">Jobs</a><a class=\"ds-nav-item\" href=\"#\">Storage</a><span class=\"ds-nav-group\">Recover</span><a class=\"ds-nav-item\" href=\"#\">Restore</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:232px;padding:12px;background:var(--color-surface-2,#f9fafb);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}.ds-nav-group{margin:12px 12px 4px;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--color-text-muted,#4b5563)}.ds-nav-item{padding:10px 12px;border-radius:8px;font-size:14px;font-weight:500;text-decoration:none;color:var(--color-text-muted,#4b5563);transition:background-color .15s,color .15s}.ds-nav-item:hover{background:var(--color-surface-3,#f3f4f6);color:var(--color-text,#111827)}.ds-nav-item[aria-current=page]{background:color-mix(in srgb,var(--color-vault,#f59e0b) 10%,transparent);color:var(--color-vault-text,#92400e)}.ds-nav-item:focus-visible{outline:2px solid var(--color-vault,#f59e0b);outline-offset:2px}"
    },
