      "html": "<div class=\"ds-seg\" role=\"group\" aria-label=\"Status\"><button aria-pressed=\"true\">All</button><button aria-pressed=\"false\">Enabled</button><button aria-pressed=\"false\">Disabled</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:3px;background:var(--color-surface-3,#f3f4f6);border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}.ds-seg button{padding:4px 10px;font-size:12px;font-weight:500;border:0;border-radius:6px;background:transparent;color:var(--color-text-muted,#4b5563);cursor:pointer}.ds-seg button:hover{color:var(--color-text,#111827)}.ds-seg button[aria-pressed=true]{background:var(--color-vault,#f59e0b);color:var(--color-on-vault,#111827)}.ds-seg button:focus-visible{outline:2px solid var(--color-vault,#f59e0b);outline-offset:2px}"
